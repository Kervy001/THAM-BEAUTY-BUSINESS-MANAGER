rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function signedIn() { return request.auth != null; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function can(p) { return isAdmin() || (active() && (p in me().perms)); }
    // Seul l'administrateur peut mettre un élément à la corbeille / le restaurer (champ deletedAt)
    function trashUntouched() { return request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null) || isAdmin(); }
    // Les articles mis à la corbeille d'un projet (trashedItems) ne bougent que par l'administrateur
    function trashedItemsUntouched() { return request.resource.data.get('trashedItems', []) == resource.data.get('trashedItems', []) || isAdmin(); }
    // Ventes : seul l'administrateur peut annuler une vente (statut) ou la modifier après validation (edits)
    function saleGuard() { return (request.resource.data.get('status', null) == resource.data.get('status', null) && request.resource.data.get('edits', []) == resource.data.get('edits', [])) || isAdmin(); }
    // Champs de vente qu'un non-administrateur ne peut jamais changer après création
    function saleFixed() { return isAdmin() || (request.resource.data.get('number', null) == resource.data.get('number', null) && request.resource.data.get('currency', null) == resource.data.get('currency', null) && request.resource.data.get('rate', null) == resource.data.get('rate', null) && request.resource.data.get('globalDiscount', null) == resource.data.get('globalDiscount', null) && request.resource.data.get('sellerId', null) == resource.data.get('sellerId', null)); }
    function notInitialized() { return !exists(/databases/$(database)/documents/settings/main); }

    // ---- Messagerie interne ----
    // Canaux communs : « general » (tous écrivent) et « announce » (l'administrateur publie, tous lisent)
    function commonChat(c) { return c == 'general' || c == 'announce'; }
    function chatDoc(c) { return get(/databases/$(database)/documents/chats/$(c)); }
    function chatMember(c) { return active() && (commonChat(c) || (exists(/databases/$(database)/documents/chats/$(c)) && request.auth.uid in chatDoc(c).data.members)); }
    function chatTouch() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt']) && request.resource.data.lastMessage.by == request.auth.uid; }

    // Premier utilisateur = administrateur (uniquement tant que l'application n'est pas initialisée)
    match /users/{id} {
      allow read: if active() || (signedIn() && request.auth.uid == id);
      allow create: if (signedIn() && request.auth.uid == id && notInitialized() && request.resource.data.role == 'admin') || isAdmin() || (can('users.manage') && request.resource.data.role != 'admin');
      // Un gestionnaire d'utilisateurs non-admin ne peut ni toucher un admin ni en créer un
      allow update: if isAdmin() || (can('users.manage') && resource.data.role != 'admin' && request.resource.data.role != 'admin');
      allow delete: if isAdmin() || (can('users.manage') && resource.data.role != 'admin');
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow create: if (signedIn() && notInitialized()) || can('settings.manage');
      allow update: if can('settings.manage') || (can('rates.write') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rate', 'rateUpdatedAt', 'updatedAt', 'updatedBy']));
      allow delete: if false;
    }
    // Alertes « nouvelle vente » : tout utilisateur actif peut en créer, seul l'administrateur les lit
    match /notifications/{id} {
      allow read: if isAdmin();
      allow create: if active() && request.resource.data.type == 'sale' && request.resource.data.get('byId', request.auth.uid) == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    // Inventaires physiques et clôtures de caisse
    match /inventories/{id} {
      allow read: if active();
      allow create, update: if can('stock.write');
      allow delete: if isAdmin();
    }
    match /cashClosings/{id} {
      allow read: if isAdmin() || can('finance.read') || (active() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (active() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /rateHistory/{id} {
      allow read: if active();
      allow create: if can('rates.write');
      allow update, delete: if false;
    }
    match /counters/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.value == 1;
      allow update: if active() && request.resource.data.value > resource.data.value && request.resource.data.value <= resource.data.value + 1;
      allow delete: if false;
    }
    match /products/{id} {
      allow read: if active();
      allow create, update: if can('products.write') || can('projects.write');
      allow delete: if isAdmin();
    }
    match /suppliers/{id} {
      allow read: if active();
      allow create, update: if can('suppliers.write') || can('projects.write');
      allow delete: if isAdmin();
    }
    match /customers/{id} {
      allow read: if active();
      allow create, update: if can('customers.write') || can('sales.write');
      allow delete: if isAdmin();
    }
    match /projects/{id} {
      allow read: if active();
      allow create: if can('projects.write') || can('stock.write') || can('payments.write') || can('expenses.write');
      allow update: if (can('projects.write') || can('stock.write') || can('payments.write') || can('expenses.write')) && trashUntouched() && trashedItemsUntouched();
      allow delete: if isAdmin(); // suppression définitive : administrateur seulement (après 30 jours de corbeille)
    }
    match /expenses/{id} {
      allow read: if can('finance.read') || can('expenses.write') || can('projects.write');
      allow create, update: if can('expenses.write');
      allow delete: if isAdmin(); // uniquement lors de la suppression définitive d'un projet
    }
    match /sales/{id} {
      allow read: if active();
      allow create: if can('sales.write') || can('sales.pay') || can('stock.write');
      allow update: if (can('sales.write') || can('sales.pay') || can('stock.write')) && trashUntouched() && saleGuard() && saleFixed();
      allow delete: if isAdmin(); // suppression définitive : administrateur seulement
    }
    match /chats/{chatId} {
      allow read: if active() && (commonChat(chatId) || request.auth.uid in resource.data.members);
      allow create: if active() && (
        (chatId == 'general' && request.resource.data.type == 'general')
        || (chatId == 'announce' && isAdmin() && request.resource.data.type == 'announce')
        || (request.resource.data.type == 'dm' && request.resource.data.members.size() == 2 && request.auth.uid in request.resource.data.members
            && request.resource.data.members[0] < request.resource.data.members[1]
            && chatId == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1])
        || (request.resource.data.type == 'group' && isAdmin() && request.resource.data.createdBy == request.auth.uid)
      );
      allow update: if active() && (
        (isAdmin() && resource.data.get('type', '') == 'group')
        || (chatTouch() && (chatId == 'general' || (chatId == 'announce' && isAdmin()) || (!commonChat(chatId) && request.auth.uid in resource.data.members)))
      );
      allow delete: if isAdmin() && resource.data.get('type', '') == 'group';

      match /messages/{mid} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId) && (chatId != 'announce' || isAdmin())
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && request.resource.data.get('image', '').size() <= 400000;
        allow update: if false;
        // Supprimer : son propre message ; l'administrateur peut aussi modérer groupes et canaux (jamais les conversations privées)
        allow delete: if chatMember(chatId) && (resource.data.by == request.auth.uid || (isAdmin() && !chatId.matches('dm_.*')));
      }
      match /reads/{u} {
        allow read: if chatMember(chatId);
        allow write: if chatMember(chatId) && u == request.auth.uid;
      }
    }
    // État « non lu » : strictement privé
    match /chatState/{u} {
      allow read, write: if active() && u == request.auth.uid;
    }
    // Boîtes (simulations de vente en gros) : brouillons, sans effet sur le stock ni les chiffres
    match /bundles/{id} {
      allow read: if can('bundles.write');
      allow create, update: if can('bundles.write');
      allow delete: if isAdmin() || (can('bundles.write') && resource.data.get('status', '') != 'vendu');
    }
    // Fonds de réinvestissement : strictement administrateur (on annule par statut, jamais de suppression)
    match /fundMoves/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /audit/{id} {
      allow read: if isAdmin() || can('finance.read');
      allow create: if active() && request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
